# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
# The URL of the backend API server
# Required: Yes
# Example: http://localhost:3001 or https://api.predictiq.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# TTS Configuration
# The URL of the services/tts text-to-speech service
# Required: No — TTS features are disabled when unset
# Example: http://localhost:3002
NEXT_PUBLIC_TTS_API_URL=http://localhost:3002
